# launch_cf command file: 16 steps of "../hello_omp.exe", 16 threads each,
# bound to NUMA domains, one step per domain.
# Each OpenMP thread is also bound to its own core.
#
# Submit with 8 steps per node, so that every node's domains fill evenly:
#   launch_cf -A $PBS_ACCOUNT -l walltime=00:10:00 \
#             --nthreads 16 --steps-per-node 8 thread-placement/cmdfile.numactl_bind
# To run more steps per node in waves, give --steps-per-node a multiple of
# 8, or --waves, and add --sync-waves.
#
# Generated by gen_cmdfile_numactl.sh.  To write it again:
#   gen_cmdfile_numactl.sh --nsteps 16 --nthreads 16 --exe "../hello_omp.exe" --bind --output "thread-placement/cmdfile.numactl_bind"
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=0 --membind=0 ../hello_omp.exe 1
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=1 --membind=1 ../hello_omp.exe 2
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=2 --membind=2 ../hello_omp.exe 3
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=3 --membind=3 ../hello_omp.exe 4
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=4 --membind=4 ../hello_omp.exe 5
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=5 --membind=5 ../hello_omp.exe 6
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=6 --membind=6 ../hello_omp.exe 7
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=7 --membind=7 ../hello_omp.exe 8
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=0 --membind=0 ../hello_omp.exe 9
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=1 --membind=1 ../hello_omp.exe 10
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=2 --membind=2 ../hello_omp.exe 11
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=3 --membind=3 ../hello_omp.exe 12
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=4 --membind=4 ../hello_omp.exe 13
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=5 --membind=5 ../hello_omp.exe 14
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=6 --membind=6 ../hello_omp.exe 15
OMP_PROC_BIND=close OMP_PLACES=cores numactl --cpunodebind=7 --membind=7 ../hello_omp.exe 16
