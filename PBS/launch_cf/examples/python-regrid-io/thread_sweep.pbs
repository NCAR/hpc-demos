#!/bin/bash
#
# Run calc_anomaly_numba_io.py alone on a develop node with 1..8 Numba threads.
# Submit with:  qsub -A $PBS_ACCOUNT thread_sweep.pbs
#
# The environment and Numba threading layer can be changed with qsub -v:
#   qsub -A $PBS_ACCOUNT -v NPL_ENV=npl,NUMBA_LAYER=default thread_sweep.pbs
# NUMBA_LAYER=default leaves NUMBA_THREADING_LAYER unset (Numba picks one).
#
# The whole node is requested so no other job shares its memory bandwidth or
# its network link to Campaign Storage.
#
#PBS -N io_thread_sweep
#PBS -q develop
#PBS -l select=1:ncpus=128:mem=235G
#PBS -l walltime=0:20:00
#PBS -j oe

cd "${PBS_O_WORKDIR}"

module load conda
conda activate "${NPL_ENV:-npl-2026a}"
NUMBA_LAYER="${NUMBA_LAYER:-omp}"
if [ "${NUMBA_LAYER}" = "default" ]; then
    unset NUMBA_THREADING_LAYER
else
    export NUMBA_THREADING_LAYER="${NUMBA_LAYER}"
fi

echo "Node: $(hostname)  Env: ${CONDA_DEFAULT_ENV}  Layer: ${NUMBA_THREADING_LAYER:-default}"

# Warm-up run, not part of the results: compiles the Numba cache for this
# environment and reads the file once, so every timed run starts from the
# same page-cache state.
echo "== warm-up (discarded)"
OMP_NUM_THREADS=8 ./calc_anomaly_numba_io.py > /dev/null
python -c "import numba; print('Numba', numba.__version__)"

for nt in 1 2 3 4 5 6 7 8; do
    echo "== threads ${nt}"
    OMP_NUM_THREADS=${nt} /usr/bin/time -f "Elapsed time: %E | Max RSS: %M KB | \
Waits (Voluntary context switches): %w | Involuntary context switches: %c" \
        ./calc_anomaly_numba_io.py --member "${nt}"
done
